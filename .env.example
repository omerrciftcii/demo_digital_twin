# The local API does not need production credentials.
# Pass an access token directly to scripts/fetch_prod_ccos.ps1 when capturing CCOs.
APP_PORT=8091
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=local-selective-password
NEO4J_DATABASE=neo4j

# Optional. Leave blank for completely local evidence inspection.
# Do not paste the real key into chat or commit it.
OPENROUTER_API_KEY=
LLM_MODEL=qwen/qwen3.5-9b
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=90
# Strict JSON answers with value assertions are verbose; 1800 truncated real questions.
LLM_ANSWER_MAX_TOKENS=4000
# When set, pin one provider for comparable evaluations.
OPENROUTER_PROVIDER=
OPENROUTER_REQUIRE_ZDR=true
# Keep off until provider/data-processing conditions and external transfer are approved.
ALLOW_EXTERNAL_REAL_DATA=false
# Development only: false shows answers that failed source/numeric checks, labelled unvalidated.
ENFORCE_ANSWER_VALIDATION=true
# The catalog and synthetic example shipped with this project contain no real patients.
LOAD_SYNTHETIC_EXAMPLE=true
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Download explicitly with scripts/prepare_embeddings.py. Runtime never downloads models.
# cco-text section highlighting uses a local encoder only. Missing weights fall back
# to lexical overlap. TEXT_EMBEDDING_DISABLE=true forces that fallback.
# TEXT_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# TEXT_EMBEDDING_DEVICE=auto
# TEXT_EMBEDDING_DISABLE=false
# Build the drug index and load the local encoder during process startup.
# TEXT_STARTUP_WARMUP=true
# Answer checks (numbers, dates, trends, causes, sentence trimming). Default on.
# A request field validation true|false overrides this. When false, the same prompt
# and the same evidence are sent, and the model text is returned unchanged.
# Emergency and dose refusal still runs; it happens before the model.
# QA_VALIDATION_ENABLED=true
# Prompt token budget. A long chart drops the least relevant section first.
# QA_CONTEXT_TOKENS=16384
# Verified path only (DETERMINISTIC_EVIDENCE_VERIFICATION_ENABLED=true): send the whole
# chart and every fact. Nothing is trimmed; a prompt that does not fit returns
# context_overflow without a model call.
# QA_FULL_CONTEXT_ENABLED=false
# vLLM /tokenize for that check. Default is LLM_BASE_URL without /v1. Local hosts only;
# otherwise, or when the call fails, the character estimate is used. The model gateway
# does not proxy /tokenize.
# LLM_TOKENIZE_URL=http://127.0.0.1:8000/tokenize
# Embedding-only sections: top K at or above this cosine. Lexical hits stay.
# TEXT_SECTION_TOP_K=4
# TEXT_SECTION_SIMILARITY=0.82
# Question similarity to emergency descriptions. At or above this, the emergency wording is used.
# TEXT_EMERGENCY_SIMILARITY=0.82

# cco-text/1 answers use the same LLM_MODEL / LLM_BASE_URL / LLM_TIMEOUT_SECONDS.
# LLM_API_KEY wins; OPENROUTER_API_KEY is the fallback. Local vLLM may use any non-empty key.
# LLM_API_KEY=
# Plain-text answers may be several sentences. This cap is separate from LLM_ANSWER_MAX_TOKENS.
# The model name is config only. Example for the current on-prem weights:
# LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
TEXT_ANSWER_MAX_TOKENS=2000
# Omit LLM_REASONING so it does not override LLM_DISABLE_THINKING.
# true (default): OpenRouter gets reasoning.enabled=false. Any other host, including
# vLLM, gets chat_template_kwargs.enable_thinking=false.
# auto: that OpenRouter flag only for qwen3 / qwq / deepseek-r1; vLLM is left alone.
# false: send neither field.
# LLM_DISABLE_THINKING=true
# LLM_REASONING=
# Fallbacks stay inside zdr + data_collection=deny. false pins one provider.
# OPENROUTER_ALLOW_FALLBACKS=true
# Retries 429/502/503/529 before the first token. Backoff doubles from this value.
# LLM_RETRY_MAX=2
# LLM_RETRY_BACKOFF_SECONDS=0.75
# OPENROUTER_REQUIRE_ZDR=true calls only openrouter.ai. vLLM: set false, or the request is refused.
# vLLM example:
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
# LLM_API_KEY=local
# OPENROUTER_REQUIRE_ZDR=false

# Separate model gateway (scripts/run_model_gateway.py). Does not change the 8091 QA API.
# Default bind is loopback. GATEWAY_ALLOW_PUBLIC_BIND=true is required for 0.0.0.0 or ::.
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8095
# GATEWAY_ALLOW_PUBLIC_BIND=false
# Comma-separated sha256 hex of API keys, and/or raw keys hashed at startup. Empty rejects every call.
# GATEWAY_API_KEY_SHA256=
# GATEWAY_API_KEYS=
# GATEWAY_VLLM_BASE_URL=http://127.0.0.1:8000/v1
# GATEWAY_VLLM_API_KEY=
# GATEWAY_QA_BASE_URL=http://127.0.0.1:8091
# GATEWAY_MODELS_CONFIG=config/gateway-models.example.json
# GATEWAY_LOG_CONTENT=false
# GATEWAY_SCRIPT_TIMEOUT_SECONDS=120

# Digital Twin doctor demo (demo.patient_chat.app)
# JSON files remain local and are discovered in filename order as Hasta 1, Hasta 2, ...
# DEMO_CCO_DIR=C:\secure\anonymous-cco
# Gemma 4 is served by your GPU host through an SSH tunnel or private network.
# DEMO_VLLM_BASE_URL=http://127.0.0.1:18000
# DEMO_GEMMA_MODEL=gemma4-26b-a4b
# DEMO_LOCAL_API_KEY=
# Qwen, Kimi, DeepSeek and Nemotron use OpenRouter. OPENROUTER_API_KEY is defined above.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DEMO_QWEN_MODEL=qwen/qwen3.5-9b
# DEMO_KIMI_MODEL=moonshotai/kimi-k2.5
# DEMO_DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
# DEMO_NEMOTRON_MODEL=nvidia/nemotron-3-nano-30b-a3b
# OpenRouter defaults to ZDR and data_collection=deny for every request.
# DEMO_OPENROUTER_REQUIRE_ZDR=true
# DEMO_OPENROUTER_ALLOW_FALLBACKS=true
# DEMO_OPENROUTER_PROVIDER=
# OpenRouter and OpenAI stay locked until this switch and their own keys are present.
# The local GPU Gemma path remains available without this switch.
# DEMO_ALLOW_EXTERNAL_MODELS=false
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEMO_OPENAI_MODEL=gpt-6-luna
# Office deployment: exact Host headers and source CIDRs, comma-separated.
# DEMO_ALLOWED_HOSTS=localhost,127.0.0.1,demo.internal.example
# DEMO_ALLOWED_NETWORKS=127.0.0.0/8,10.40.0.0/16


